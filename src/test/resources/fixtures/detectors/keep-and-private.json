{
  "name": "detectors/keep-and-private",
  "description": "keep_private_ips keeps RFC1918 addresses; public IPs are mapped to the documentation range; keep_hosts and localhost are untouched.",
  "settings": { "keep_private_ips": true },
  "steps": [
    {
      "op": "anonymize",
      "input": "10.10.11.5 and 8.8.4.4 and example.com and localhost",
      "expect": {
        "equals": "10.10.11.5 and 192.0.2.1 and example.com and localhost",
        "contains": ["10.10.11.5", "example.com", "localhost"],
        "notContains": ["8.8.4.4"]
      }
    }
  ],
  "mapping": { "ip": { "8.8.4.4": "192.0.2.1" } },
  "counters": { "ip": 1 }
}
